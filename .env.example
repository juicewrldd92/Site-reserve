# Copie ce fichier en .env.local puis renseigne tes clés.

# ---------------------------------------------------------------- Supabase
# Project settings → API → Project URL / anon public key.
# La clé anon est publique par construction : c'est la RLS qui protège, pas elle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------ Notifications
# Clé publique VAPID. Publique par nature — c'est la privée, côté serveur,
# qui signe les envois.
VITE_VAPID_PUBLIC_KEY=

# ==============================================================================
# Les variables ci-dessous ne servent QUE côté serveur (fonctions Vercel).
# Elles n'ont pas le préfixe VITE_, donc elles ne partent jamais dans le
# navigateur. Ne les mets pas dans ce fichier : colle-les directement dans
# Vercel → Settings → Environment Variables.
#
#   SUPABASE_SERVICE_ROLE_KEY   contourne toute la RLS
#   VAPID_PRIVATE_KEY           signe les notifications push
#   VAPID_CONTACT               mailto:ton@adresse
#   STRIPE_SECRET_KEY           sk_live_… ou sk_test_…
#   STRIPE_PRICE_ID             price_… (le tarif mensuel)
#   STRIPE_WEBHOOK_SECRET       whsec_…
#   SITE_URL                    https://site-reserve.vercel.app
#   CRON_SECRET                 protège l'appel quotidien des alertes
# ==============================================================================
